{
    "name": "portfolio-app",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "build-css": "sass styles/index.scss styles/index.css --watch",
        "start": "expo start --dev-client -c",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo prebuild && ENVFILE=.env expo run:android",
        "ios": "ENVFILE=.env expo run:ios",
        "web": "expo start --web",
        "test": "jest --watchAll",
        "lint": "expo lint",
        "build-android": "ENVFILE=.env eas build -p android --profile preview",
        "build-local": "(cd android && ./gradlew assembleDebug)",
        "build-local-release": "(cd android && ./gradlew assembleRelease)",
        "bump-build-release": "node scripts/bumpVersionAndBuild.js",
        "postinstall": "node scripts/patch-nativewind.js"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        }
    },
    "dependencies": {
        "@expo-google-fonts/inter": "^0.2.3",
        "@expo/vector-icons": "^14.0.4",
        "@react-native-async-storage/async-storage": "2.1.2",
        "@react-native-clipboard/clipboard": "^1.16.1",
        "@react-native-community/masked-view": "^0.1.11",
        "@react-navigation/bottom-tabs": "^7.2.0",
        "@react-navigation/material-top-tabs": "^7.1.0",
        "@react-navigation/native": "^7.0.14",
        "@shopify/flash-list": "1.7.6",
        "animejs": "^3.2.2",
        "axios": "^1.7.9",
        "base-64": "^1.0.0",
        "clsx": "^2.1.1",
        "crypto": "^1.0.1",
        "expo": "^53.0.8",
        "expo-application": "^6.1.4",
        "expo-auth-session": "~6.2.1",
        "expo-blur": "~14.1.5",
        "expo-constants": "~17.1.7",
        "expo-crypto": "~14.1.5",
        "expo-dev-client": "~5.2.4",
        "expo-file-system": "~18.1.11",
        "expo-font": "~13.3.2",
        "expo-haptics": "~14.1.4",
        "expo-image": "~2.4.0",
        "expo-jwt": "^1.8.2",
        "expo-linking": "~7.1.7",
        "expo-random": "^14.0.1",
        "expo-router": "~5.1.6",
        "expo-secure-store": "~14.2.4",
        "expo-splash-screen": "~0.30.10",
        "expo-status-bar": "~2.2.3",
        "expo-symbols": "~0.4.5",
        "expo-system-ui": "~5.0.11",
        "expo-web-browser": "~14.2.0",
        "immer": "^10.1.1",
        "jwt-decode": "^4.0.0",
        "lodash": "^4.17.21",
        "metro-react-native-babel-preset": "^0.77.0",
        "moment": "^2.30.1",
        "nativewind": "^4.1.23",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-native": "0.79.5",
        "react-native-animatable": "^1.4.0",
        "react-native-gesture-handler": "~2.24.0",
        "react-native-image-picker": "^8.0.0",
        "react-native-pager-view": "6.7.1",
        "react-native-paper": "^5.13.1",
        "react-native-reanimated": "~3.17.4",
        "react-native-reanimated-carousel": "^4.0.2",
        "react-native-restart": "^0.0.27",
        "react-native-safe-area-context": "5.4.0",
        "react-native-screens": "~4.11.1",
        "react-native-shimmer-placeholder": "^2.0.9",
        "react-native-smallcase-gateway": "^5.3.0",
        "react-native-svg": "15.11.2",
        "react-native-tab-view": "^4.0.5",
        "react-native-vector-icons": "^10.2.0",
        "react-native-web": "^0.20.0",
        "react-native-webview": "13.13.5",
        "react-native-worklets-core": "^1.6.2",
        "tailwindcss": "^3.4.17",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@react-native-community/cli": "latest",
        "@types/jest": "^29.5.12",
        "@types/react": "~19.0.10",
        "jest": "~29.7.0",
        "jest-expo": "~53.0.10",
        "react-native-css-transformer": "^2.0.0",
        "sass": "^1.83.1",
        "typescript": "~5.8.3"
    },
    "private": true
}
